---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Certifications from '../components/Certifications.astro';
import References from '../components/References.astro';
import Contact from '../components/Contact.astro';
import { SITE } from '../lib/site';

const pageTitle = `${SITE.displayName} — ${SITE.title} · M.S. Candidate in Industrial Automation`;
const pageDescription =
  'Electronic Engineer and M.S. candidate in Industrial Automation. Computer vision, deep learning, cloud deployment, telemetry and IoT: PyTorch, Amazon SageMaker, Docker, ThingsBoard, Wi-Fi HaLow.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Hero />
  <About />
  <Skills />
  <Experience />
  <Education />
  <Certifications />
  <References />
  <Contact />
</BaseLayout>
