---
import Icon from './Icon.astro';
import { NAV_LINKS, CV_URL } from '../lib/site';
import { CV_AVAILABLE } from '../lib/cv';

const desktopLinks = NAV_LINKS.filter((link) => link.desktop !== false);
---

<header class="site-header" data-nav>
  <nav aria-label="Primary">
    <div class="container nav">
      <a class="brand" href="#home" aria-label="Back to top — Brayan Pisso">
        <span class="brand-mark" aria-hidden="true"></span>
        BRAYAN PISSO
      </a>

      <ul class="nav-desktop">
        {
          desktopLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={link.sectionId === 'home' ? 'true' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        {
          CV_AVAILABLE && (
            <li>
              <a href={CV_URL} download>
                CV
              </a>
            </li>
          )
        }
      </ul>

      {/*
        Both glyphs ship in the markup and CSS selects one from the button's
        own `aria-expanded`, so the visible icon cannot disagree with the state
        announced to assistive technology.
      */}
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Open menu"
      >
        <span class="nav-toggle-icon" data-icon="menu"><Icon name="menu" size={19} strokeWidth={1.8} /></span>
        <span class="nav-toggle-icon" data-icon="close"><Icon name="close" size={19} strokeWidth={1.8} /></span>
      </button>
    </div>

    <div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden aria-hidden="true">
      <div class="container">
        <ul>
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} aria-current={link.sectionId === 'home' ? 'true' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            CV_AVAILABLE && (
              <li>
                <a href={CV_URL} download>
                  Download CV (PDF)
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </nav>
</header>
