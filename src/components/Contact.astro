---
import Icon from './Icon.astro';
import Documents from './Documents.astro';
import { SITE, CV_URL } from '../lib/site';
import { CV_AVAILABLE } from '../lib/cv';
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="section-title">{SITE.fullName}</h2>
      <p class="contact-sub">{SITE.title} — {SITE.location}</p>
    </div>

    <div class="contact-layout">
      <div class="contact-card">
        <dl class="contact-list">
          <div class="contact-item">
            <dt>Email</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div class="contact-item">
            <dt>Phone</dt>
            <dd><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></dd>
          </div>
          <div class="contact-item">
            <dt>Location</dt>
            <dd>{SITE.location}</dd>
          </div>
          <div class="contact-item">
            <dt>GitHub</dt>
            <dd>
              <a href={SITE.github} target="_blank" rel="noopener noreferrer">BRAYANPISSO02</a>
            </dd>
          </div>
          <div class="contact-item">
            <dt>LinkedIn</dt>
            <dd>
              <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">brayan-ricardo-pisso-ramirez</a>
            </dd>
          </div>
        </dl>

        <div class="contact-actions">
          <a class="btn btn--primary" href={`mailto:${SITE.email}`}>
            Email me
            <Icon name="arrow-right" size={15} strokeWidth={2} />
          </a>
          {
            CV_AVAILABLE && (
              <a class="btn btn--secondary" href={CV_URL} download>
                <Icon name="download" size={15} strokeWidth={1.8} />
                Download CV
              </a>
            )
          }
          <a class="btn btn--subtle" href={SITE.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={15} strokeWidth={1.8} />
            GitHub
          </a>
          <a class="btn btn--subtle" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={15} strokeWidth={1.8} />
            LinkedIn
          </a>
        </div>
      </div>

      <Documents />
    </div>
  </div>
</section>
