---
import { EDUCATION } from '../lib/site';
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Education</p>
      <h2 id="education-title" class="section-title">Education</h2>
    </div>

    <div class="entry-list">
      {
        EDUCATION.map((item) => (
          <article class="entry entry--card">
            <div class="entry-aside">
              <p class="entry-period">{item.period}</p>
            </div>
            <div class="entry-body">
              <h3 class="entry-title">{item.degree}</h3>
              <p class="entry-org">{item.institution}</p>
              {item.researchNote && <p class="entry-note">{item.researchNote}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
