---
import { LANGUAGE_SKILLS, SKILL_GROUPS, SOFT_SKILLS } from '../lib/site';
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Skills</p>
      <h2 id="skills-title" class="section-title">Technical toolkit</h2>
    </div>

    <div class="skills-grid">
      {
        SKILL_GROUPS.map((group) => (
          <article class="skill-group">
            <h3 class="skill-label">{group.label}</h3>
            <ul class="chip-list">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </article>
        ))
      }

      <article class="skill-group skill-group--languages">
        <h3 class="skill-label">Languages</h3>
        <p class="skill-items">{LANGUAGE_SKILLS}</p>
      </article>
    </div>

    <div class="soft-skills">
      <h3 class="skill-label">Soft skills</h3>
      <ul class="chip-list">
        {SOFT_SKILLS.map((item) => <li class="chip chip--soft">{item}</li>)}
      </ul>
    </div>
  </div>
</section>
