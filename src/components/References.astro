---
import { REFERENCES, REFERENCES_NOTE } from '../lib/site';
---

<section id="references" class="section" aria-labelledby="references-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">References</p>
      <h2 id="references-title" class="section-title">References</h2>
    </div>

    <div class="refs-grid">
      {
        REFERENCES.map((ref) => (
          <article class="ref">
            <h3 class="ref-name">{ref.name}</h3>
            <p class="ref-creds">{ref.credentials}</p>
            <p class="ref-aff">{ref.affiliation}</p>
          </article>
        ))
      }
    </div>

    <p class="refs-note">{REFERENCES_NOTE}</p>
  </div>
</section>
